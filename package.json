{
  "name": "atlas-finance",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "ATLAS Finance \u2014 fictional multi-brand banking demo and design-system showcase. Demo only, no real banking.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/build-css.mjs && vite",
    "build": "node scripts/build-css.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "tokens:check": "node scripts/check-tokens.mjs",
    "tokens:bundle": "node scripts/tokens-bundle.mjs",
    "seed:check": "node scripts/check-seed.mjs",
    "tokens:css": "node scripts/build-css.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
